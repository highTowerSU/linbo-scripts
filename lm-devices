#!/bin/bash

# ==========================================
# lm-devices: Liste von Rechnern aus sophomorix/devices.csv
# Erweiterung: Image-Version anzeigen, veraltete Hosts markieren
# ==========================================

CSV="/etc/linuxmuster/sophomorix/default-school/devices.csv"
HIDDEN="byod|ipad|server|admin|switch|router|printer|staffcomputer|iponly|shelly"
LINBO_LOG="/var/log/linuxmuster/linbo"
DEFAULT_IMAGE="UbuntuV2"

MODE="hosts"
ROOM=""
TYPE=""
SHOW_HIDDEN=0
QUIET=0
SHOW_VERSION=0
ONLY_OUTDATED=0
IMAGE="$DEFAULT_IMAGE"
SHOW_SYNC=0
SYNC_OLDER_THAN=""
SYNC_DATE_THRESHOLD=""

format_timestamp() {
    local raw="$1"

    if [[ $raw =~ ^[0-9]{14}$ ]]; then
        date -d "${raw:0:4}-${raw:4:2}-${raw:6:2} ${raw:8:2}:${raw:10:2}:${raw:12:2}" '+%Y-%m-%d %H:%M:%S' 2>/dev/null && return
    fi

    if [[ $raw =~ ^[0-9]{12}$ ]]; then
        date -d "${raw:0:4}-${raw:4:2}-${raw:6:2} ${raw:8:2}:${raw:10:2}:00" '+%Y-%m-%d %H:%M:%S' 2>/dev/null && return
    fi

    echo "$raw"
}

# Farben
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

THREE_DAYS_SECONDS=$((3 * 24 * 60 * 60))
FOUR_WEEKS_SECONDS=$((4 * 7 * 24 * 60 * 60))

# ===============================
# Parameter auswerten
# ===============================
while [[ $# -gt 0 ]]; do
    case "$1" in
        --hosts|--rooms|--types|--ips) MODE="${1#--}" ;;
        --room) ROOM="$2"; shift ;;
        --type) TYPE="$2"; shift ;;
        --all|--hidden) SHOW_HIDDEN=1 ;;
        --quiet) QUIET=1 ;;
        --show-version) SHOW_VERSION=1 ;;
        --show-sync) SHOW_SYNC=1 ;;
        --sync-older-than)
            SHOW_SYNC=1
            SYNC_OLDER_THAN="$2"
            shift
            ;;
        --outdated) ONLY_OUTDATED=1 ;;
        --image) IMAGE="$2"; shift ;;
        *) echo "Usage: $0 [--hosts|--rooms|--types|--ips] [--room ROOM] [--type TYPE] [--all|--hidden] [--image IMAGE] [--show-version] [--show-sync] [--sync-older-than DATE] [--outdated] [--quiet]"; exit 1 ;;
    esac
    shift
done

# ===============================
# Sync-Datum validieren
# ===============================
if [[ -n "$SYNC_OLDER_THAN" ]]; then
    if ! SYNC_DATE_THRESHOLD=$(date -d "$SYNC_OLDER_THAN" +%s 2>/dev/null); then
        echo "Ungültiges Datum für --sync-older-than: '$SYNC_OLDER_THAN'. Erwartetes Format z.B. '2024-01-31'."
        exit 1
    fi
fi

# ===============================
# Image-Timestamp aus .info nur prüfen, wenn gewünscht
# ===============================
if [[ $SHOW_VERSION -eq 1 || $ONLY_OUTDATED -eq 1 ]]; then
    IMAGE_FOLDER=$(basename "$IMAGE" .qcow2)
    IMAGE_FILE="$IMAGE_FOLDER.qcow2"
    IMAGE_INFO="/srv/linbo/images/$IMAGE_FOLDER/$IMAGE_FOLDER.qcow2.info"

    if [[ -f "$IMAGE_INFO" ]]; then
        # Timestamp aus info-Datei extrahieren
        CURRENT_IMAGE_TIMESTAMP=$(grep -oP 'timestamp="([0-9]+)"' "$IMAGE_INFO" | head -n1 | sed 's/timestamp="//;s/"//')

        if [[ $QUIET -eq 0 ]]; then
          echo "Die aktuelle Imageversion '${IMAGE_FOLDER}' ist: $CURRENT_IMAGE_TIMESTAMP"
        fi

        if [[ -z "$CURRENT_IMAGE_TIMESTAMP" ]]; then
            echo "Kein Timestamp für Image $IMAGE_FILE in $IMAGE_INFO gefunden!"
            exit 1
        fi
    else
        echo "Image info file für $IMAGE_FOLDER nicht gefunden!"
        exit 1
    fi
fi

# ===============================
# Devices filtern
# ===============================
if [[ $SHOW_HIDDEN -eq 0 ]]; then
    FILTER="(^(#|$))|${HIDDEN}"
else
    FILTER="^(#|$)"
fi

mapfile -t HOSTS < <(grep -viE "$FILTER" "$CSV" \
    | awk -F';' -v room="$ROOM" -v type="$TYPE" '
        !/^#/ && NF {
            if(room!="" && $1!=room) next
            if(type!="" && $10!=type) next
            print $2
        }' \
    | sort -u)

HOST_COL_WIDTH=0
for HOST in "${HOSTS[@]}"; do
    if (( ${#HOST} > HOST_COL_WIDTH )); then
        HOST_COL_WIDTH=${#HOST}
    fi
done

if (( HOST_COL_WIDTH == 0 )); then
    HOST_COL_WIDTH=1
fi

# ===============================
# Ausgabe
# ===============================
for HOST in "${HOSTS[@]}"; do
    HOST_PADDED=$(printf "%-${HOST_COL_WIDTH}s" "$HOST")
    IMAGE_OUTDATED=0
    HOST_HAS_ISSUE=0
    if [[ $SHOW_VERSION -eq 1 || $ONLY_OUTDATED -eq 1 || $SHOW_SYNC -eq 1 ]]; then
        OUT_STR="$HOST_PADDED"
    else
        OUT_STR="$HOST"
    fi

    if [[ $SHOW_VERSION -eq 1 || $ONLY_OUTDATED -eq 1 ]]; then
        LOG_FILE="$LINBO_LOG/${HOST}_image.status"

        if [[ -f "$LOG_FILE" ]]; then
            # Letzte Zeile mit dem Image-Namen
            LINE=$(grep "$IMAGE_FILE" "$LOG_FILE" | tail -n1)
            if [[ -n "$LINE" ]]; then
                IMAGE_TS_IN_LOG=$(echo "$LINE" | awk -F'"' '{print $2}') # Version im Log
            else
                IMAGE_TS_IN_LOG=""
            fi
        else
            IMAGE_TS_IN_LOG=""
        fi

        # Veraltet prüfen & Farbe setzen
        if [[ "$IMAGE_TS_IN_LOG" != "$CURRENT_IMAGE_TIMESTAMP" ]]; then
            VERSION_DISPLAY="${RED}${IMAGE_TS_IN_LOG:-"keine info"}${NC}"  # rot für veraltet
            IMAGE_OUTDATED=1
            HOST_HAS_ISSUE=1
        else
            VERSION_DISPLAY="${GREEN}${IMAGE_TS_IN_LOG}${NC}"  # grün für aktuell
        fi

        OUT_STR+=" | $VERSION_DISPLAY"
    fi

    if [[ $SHOW_SYNC -eq 1 ]]; then
        LAST_SYNC=""
        LAST_SYNC_EPOCH=""
        STATUS_FILE="$LINBO_LOG/${HOST}_image.status"

        if [[ -f "$STATUS_FILE" ]]; then
            RAW_TS=$(grep -oP 'lastsync="([0-9]{12,14})"' "$STATUS_FILE" | tail -n1 | sed 's/.*="//;s/"$//')
            if [[ -n "$RAW_TS" ]]; then
                LAST_SYNC=$(format_timestamp "$RAW_TS")
            fi

            if [[ -z "$LAST_SYNC" ]]; then
                RAW_TS=$(grep -oP 'synctime="([0-9]{12,14})"' "$STATUS_FILE" | tail -n1 | sed 's/.*="//;s/"$//')
                if [[ -n "$RAW_TS" ]]; then
                    LAST_SYNC=$(format_timestamp "$RAW_TS")
                fi
            fi

            if [[ -z "$LAST_SYNC" ]]; then
                RAW_TS=$(grep -oP '^[0-9]{12,14}(?=\s+applied:)' "$STATUS_FILE" | tail -n1)
                if [[ -n "$RAW_TS" ]]; then
                    LAST_SYNC=$(format_timestamp "$RAW_TS")
                fi
            fi
        fi

        shopt -s nullglob
        SYNC_FILES=("$LINBO_LOG"/${HOST}*.log)
        shopt -u nullglob

        if [[ -z "$LAST_SYNC" && ${#SYNC_FILES[@]} -gt 0 ]]; then
            RAW_TS=$(grep -hEi 'sync' "${SYNC_FILES[@]}" 2>/dev/null | \
                grep -oP '[0-9]{4}-[0-9]{2}-[0-9]{2}[ T][0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n1)
            if [[ -n "$RAW_TS" ]]; then
                LAST_SYNC=${RAW_TS//T/ }
            fi
        fi

        if [[ -z "$LAST_SYNC" && ${#SYNC_FILES[@]} -gt 0 ]]; then
            RAW_TS=$(grep -hEi 'sync' "${SYNC_FILES[@]}" 2>/dev/null | \
                grep -oP '[0-9]{12,14}' | tail -n1)
            if [[ -n "$RAW_TS" ]]; then
                LAST_SYNC=$(format_timestamp "$RAW_TS")
            fi
        fi

        if [[ -n "$LAST_SYNC" ]]; then
            LAST_SYNC_EPOCH=$(date -d "$LAST_SYNC" +%s 2>/dev/null || echo "")
        fi

        if [[ -n "$SYNC_DATE_THRESHOLD" && -n "$LAST_SYNC_EPOCH" && $LAST_SYNC_EPOCH -ge $SYNC_DATE_THRESHOLD ]]; then
            continue
        fi

        SYNC_DISPLAY="${LAST_SYNC:-"keine sync info"}"

        SYNC_COLOR="$GREEN"
        if [[ -z "$LAST_SYNC_EPOCH" ]]; then
            SYNC_COLOR="$RED"
        else
            CURRENT_TIME=$(date +%s)
            if (( CURRENT_TIME < LAST_SYNC_EPOCH )); then
                AGE=0
            else
                AGE=$((CURRENT_TIME - LAST_SYNC_EPOCH))
            fi

            if (( IMAGE_OUTDATED == 1 || AGE >= FOUR_WEEKS_SECONDS )); then
                SYNC_COLOR="$RED"
            elif (( AGE >= THREE_DAYS_SECONDS )); then
                SYNC_COLOR="$YELLOW"
            else
                SYNC_COLOR="$GREEN"
            fi
        fi

        if [[ "$SYNC_COLOR" != "$GREEN" ]]; then
            HOST_HAS_ISSUE=1
        fi

        SYNC_DISPLAY="${SYNC_COLOR}${SYNC_DISPLAY}${NC}"

        OUT_STR="$OUT_STR | letzter Sync: $SYNC_DISPLAY"
    fi

    if [[ $ONLY_OUTDATED -eq 1 && $HOST_HAS_ISSUE -eq 0 ]]; then
        continue
    fi

    echo -e "$OUT_STR"
done
